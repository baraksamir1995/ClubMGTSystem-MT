# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ── Laravel API ─────────────────────────────────────────────────────────────────
# LARAVEL_API_URL=https://api.clbyapp.com

# ── Email (Resend) ───────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── Paymob ──────────────────────────────────────────────────────────────────────
PAYMOB_SECRET_KEY=your_paymob_secret_key_here
PAYMOB_PUBLIC_KEY=your_paymob_public_key_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
PAYMOB_IFRAME_ID=your_paymob_iframe_id_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# ── Sentry ───────────────────────────────────────────────────────────────────────
# Leave blank locally — reporting only fires when NODE_ENV=production AND a DSN
# is set (i.e. the Coolify container). NEXT_PUBLIC_SENTRY_DSN is the browser DSN;
# SENTRY_DSN is the server DSN (use the same project DSN for both if unsure).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: override the environment tag (defaults to NODE_ENV, e.g. "production").
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
