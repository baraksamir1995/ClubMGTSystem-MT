#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Flutter/Generated.xcconfig"

APP_DISPLAY_NAME = Shift
PRODUCT_BUNDLE_IDENTIFIER = com.clbyapp.shift
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-shift
DEVELOPMENT_TEAM = AXBRK75K78

// Shift versions independently of clby. Both keys override the values
// Generated.xcconfig pulls from pubspec, so MARKETING_VERSION and
// CURRENT_PROJECT_VERSION (which read $(FLUTTER_BUILD_NAME/NUMBER) from
// the build settings) reflect shift's own progression. Bump these for
// each shift release; clby's pubspec version is unaffected.
FLUTTER_BUILD_NAME = 1.0.2
FLUTTER_BUILD_NUMBER = 4

// Per-flavor launch screen — references LaunchScreenShift.storyboard
// generated by flutter_native_splash from flutter_native_splash-shift.yaml.
LAUNCH_STORYBOARD_NAME = LaunchScreenShift
