  "fixed_sql": [
    {
      "name": "outbox_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_events\" (\"event_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"attendance_method\" TEXT NULL, \"gym_id\" TEXT NOT NULL, \"branch_id\" TEXT NULL, \"member_id\" TEXT NOT NULL, \"class_session_id\" TEXT NULL, \"studio_id\" TEXT NULL, \"service_assignment_id\" TEXT NULL, \"device_recorded_at\" TEXT NOT NULL, \"device_recorded_at_ms\" INTEGER NOT NULL, \"device_timezone\" TEXT NOT NULL, \"qr_raw\" TEXT NULL, \"note\" TEXT NULL, \"metadata\" TEXT NOT NULL DEFAULT '{}', \"actor_user_id\" TEXT NOT NULL, \"actor_type\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', \"sync_attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NULL, \"last_attempt_at\" INTEGER NULL, \"last_sync_error\" TEXT NULL, \"result_status\" TEXT NULL, \"result_code\" TEXT NULL, \"result_message\" TEXT NULL, \"official_id\" TEXT NULL, \"flags\" TEXT NOT NULL DEFAULT '[]', \"server_received_at\" TEXT NULL, \"processed_at\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"event_id\"), CHECK (kind IN ('attendance','service_session')), CHECK (attendance_method IS NULL OR attendance_method IN ('staff_qr','member_qr','manual')), CHECK (sync_status IN ('pending','syncing','synced','rejected')));"
        }
      ]
    },
    {
      "name": "cached_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_members\" (\"gym_member_id\" TEXT NOT NULL, \"member_number\" TEXT NULL, \"full_name\" TEXT NOT NULL, \"search_text\" TEXT NOT NULL, \"phone_last4\" TEXT NULL, \"photo_url\" TEXT NULL, \"status\" TEXT NULL, PRIMARY KEY (\"gym_member_id\"));"
        }
      ]
    },
